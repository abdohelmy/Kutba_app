KHUTBA_SECRET_KEY=replace-with-at-least-32-random-characters
KHUTBA_DATABASE_URL=sqlite:///./khutba.db
KHUTBA_STORAGE_DIR=./data
# Optional override; the supplied 1,000-entry CSV is bundled at this path.
KHUTBA_GLOSSARY_PATH=app/data/islamic_khutbah_1000_meanings_simple_literal.csv
KHUTBA_TRANSLATION_PROVIDER=openai
KHUTBA_OPENAI_API_KEY=
KHUTBA_OPENAI_MODEL=gpt-5.6-luna
KHUTBA_VERIFIER_MODEL=gpt-5.6-luna
KHUTBA_OPENAI_BASE_URL=
KHUTBA_REASONING_EFFORT=high
KHUTBA_ACCESS_TOKEN_MINUTES=60
KHUTBA_MAX_DOCUMENT_BYTES=15728640
KHUTBA_OCR_ENABLED=true
KHUTBA_PDFTOPPM_COMMAND=pdftoppm
KHUTBA_TESSERACT_COMMAND=tesseract
KHUTBA_OCR_LANGUAGES=ara
KHUTBA_OCR_DPI=300
KHUTBA_MAX_OCR_PAGES=30
KHUTBA_OCR_TIMEOUT_SECONDS=120
KHUTBA_OCR_PAGE_SEGMENTATION_MODE=3
KHUTBA_CANONICAL_SOURCES_ENABLED=true
KHUTBA_CANONICAL_SOURCE_TIMEOUT_SECONDS=30
# "legacy" works without credentials for local testing. Use "oauth" for the current production API.
KHUTBA_QURAN_API_MODE=legacy
KHUTBA_QURAN_LEGACY_API_BASE_URL=https://api.quran.com/api/v4
# 20 is Saheeh International. This can be changed to another approved Quran.com resource ID.
KHUTBA_QURAN_TRANSLATION_ID=20
# 57 is Quran.com's full-ayah Latin transliteration resource.
KHUTBA_QURAN_TRANSLITERATION_ID=57
KHUTBA_QURAN_FOUNDATION_ENVIRONMENT=production
KHUTBA_QURAN_FOUNDATION_CLIENT_ID=
KHUTBA_QURAN_FOUNDATION_CLIENT_SECRET=
KHUTBA_SUNNAH_API_BASE_URL=https://api.sunnah.com/v1
KHUTBA_SUNNAH_API_KEY=
# When the API cannot resolve a hadith, OpenAI web search is restricted to sunnah.com.
KHUTBA_SUNNAH_WEB_SEARCH_FALLBACK_ENABLED=true
